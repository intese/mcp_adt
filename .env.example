# SAP System Connection
SAP_URL=https://your-sap-host:443
SAP_CLIENT=100
SAP_USER=your_technical_user
SAP_PASSWORD=your_password
SAP_LANGUAGE=EN

# TLS / SSL
# Set to false only for development with self-signed certs
SAP_TLS_VERIFY=true
# Optional: path to custom CA bundle
# SAP_CA_BUNDLE=/path/to/ca-bundle.crt

# Logging
# Level: error | warn | info | debug | trace
LOG_LEVEL=info
# Log to file in addition to stderr
# LOG_FILE=/var/log/sap-adt-mcp.log

# HTTP Client
REQUEST_TIMEOUT=60000
CONNECT_TIMEOUT=10000
MAX_RETRIES=3
RETRY_DELAY=1000

# Session
# Keep session alive with periodic pings (milliseconds, 0 = disabled)
SESSION_KEEPALIVE_INTERVAL=120000

# Cache
# Object metadata cache TTL in milliseconds
METADATA_CACHE_TTL=300000
